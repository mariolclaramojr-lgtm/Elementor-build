{
  "manifest_version": 3,
  "name": "Presenter Cam",
  "version": "1.2.1",
  "description": "Show your camera while presenting in Google Meet: as a bubble inside the tab you share, or in a floating window.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "Presenter Cam",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
