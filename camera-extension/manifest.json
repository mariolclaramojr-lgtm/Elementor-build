{
  "manifest_version": 3,
  "name": "Presenter Cam",
  "version": "1.0.0",
  "description": "Show your camera in a floating window while presenting in Google Meet.",
  "action": {
    "default_title": "Open Presenter Cam"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
